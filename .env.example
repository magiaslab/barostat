# ─── Auth.js ────────────────────────────────────────────────────────────
# Genera con: npx auth secret
AUTH_SECRET=

# Google Cloud Console del Workspace SVB Basket San Vincenzo
# API e servizi → Credenziali → ID client OAuth 2.0 → Applicazione web
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dominio Workspace: SOLO gli account di questo dominio possono entrare.
# Lato server: email_verified AND (hd === dominio OR email @dominio).
# hd da solo non basta e può mancare; l'email del dominio resta accettata se verified.
GOOGLE_WORKSPACE_DOMAIN=basketsanvincenzo.it

# ─── Neon ───────────────────────────────────────────────────────────────
# Connection string con pooling (postgresql://...-pooler...neon.tech/...)
DATABASE_URL=

# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=BaroStat 24
